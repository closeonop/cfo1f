# Frontend environment — copy to .env.local and adjust if needed
# Where the Spring Boot API lives
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# Server-only: Next.js verifies the existing Spring Boot bearer session here.
API_INTERNAL_URL=http://127.0.0.1:8080/api
ASSISTANT_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# Provider configuration. Never prefix these with NEXT_PUBLIC_.
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=replace-with-your-private-groq-key
AI_MODEL=openai/gpt-oss-20b
